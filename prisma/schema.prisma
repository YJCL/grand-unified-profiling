generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String      @id @default(uuid())
  email         String?     @unique
  passwordHash  String?     // scrypt(salt:hash)。本登録済みユーザーのみ。平文は保存しない
  isPremium     Boolean     @default(false)
  createdAt     DateTime    @default(now())
  birthDate     String?
  birthPlace    String?
  birthTime     String?
  gender        String?
  language      String?     @default("ja")
  name          String?
  characterType String?
  enneagram     String?
  mbti          String?
  widgetOrder   String?  // JSON: ["daily","calendar","chat","profile"]
  profileType   String?  @default("self") // "self" | "family" | "friend"
  chatDate      String?  // 無料枠カウントの対象日 YYYY-MM-DD
  chatUsed      Int      @default(0) // その日の使用回数（無料は1日3回）
  stripeCustomerId String? // Stripeの顧客ID（解約Webhookでの突き合わせ用）
  failedLogins  Int       @default(0) // 連続ログイン失敗回数
  lockedUntil   DateTime? // アカウントロック解除時刻
  tickets       Int       @default(0) // 鑑定チケット（無料枠を超えて1回使える）
  lastShareTicketDate String? // シェア報酬を最後に付与した日 YYYY-MM-DD（1日1回）
  lastLoginBonusDate  String? // ログインボーナスを最後に付与した日 YYYY-MM-DD（1日1回）
  expiresAt     DateTime?
  chatLogs      ChatLog[]
  dailyLogs     DailyLog[]
  diagnoses     Diagnosis[]
  pushSubs      PushSubscription[]
}

// ファネル計測イベント（収益化ロードマップ P0）。
// 第一者・自前。外部アナリティクス不要。anonId は signup 前の匿名識別子。
model Event {
  id        String   @id @default(uuid())
  name      String   // 'landing_view' | 'onboarding_start' | 'reading_complete' | 'app_open' | 'paywall_view' | 'paywall_click' | ...
  anonId    String?  // localStorage の匿名ID（未ログインでも追える）
  userId    String?  // 分かればユーザーID（インスタント/本登録どちらも）
  props     String?  // 任意の付随情報（JSON文字列）
  createdAt DateTime @default(now())

  @@index([name, createdAt])
  @@index([anonId])
  @@index([createdAt])
}

// Web Push（VAPID）の購読情報。1ユーザーが複数端末を持てる。
model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  endpoint  String   @unique // ブラウザ毎に一意。再購読時の突き合わせキー
  p256dh    String   // 公開鍵（暗号化用）
  auth      String   // 認証シークレット
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Diagnosis {
  id        String   @id @default(uuid())
  userId    String
  data      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model ChatLog {
  id        String   @id @default(uuid())
  userId    String
  messages  String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model DailyLog {
  id        String   @id @default(uuid())
  userId    String
  date      String
  data      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, date])
}

model TransferCode {
  id        String   @id @default(uuid())
  code      String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model PasswordReset {
  id        String   @id @default(uuid())
  tokenHash String   @unique // 生トークンのSHA-256。生値はメールのみ
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
}
